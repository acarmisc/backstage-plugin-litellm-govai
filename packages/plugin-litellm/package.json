{
  "name": "@acarmisc/backstage-plugin-litellm",
  "version": "0.17.0",
  "backstage": {
    "role": "frontend-plugin",
    "pluginId": "litellm",
    "pluginPackages": [
      "@acarmisc/backstage-plugin-litellm"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/acarmisc/backstage-plugin-litellm-govai"
  },
  "homepage": "https://github.com/acarmisc/backstage-plugin-litellm-govai#readme",
  "license": "Apache-2.0",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.cjs.js"
    }
  },
  "main": "dist/index.cjs.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node build.js && tsc -p tsconfig.json",
    "lint": "eslint src dev --ext .ts,.tsx",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/**/*.test.js dist-test/*.test.js",
    "api-report": "npm run build && api-extractor run --local --verbose",
    "prepack": "npm run build",
    "postpack": ""
  },
  "dependencies": {
    "@backstage/catalog-model": "^1.9.0",
    "@backstage/core-components": "^0.18.10",
    "@backstage/core-plugin-api": "^1.12.6",
    "@backstage/frontend-plugin-api": "^0.17.0",
    "@backstage/plugin-catalog-react": "^3.1.0",
    "@backstage/plugin-permission-common": "^0.9.9",
    "@backstage/plugin-permission-react": "^0.5.3",
    "@backstage/theme": "^0.6.0",
    "@backstage/types": "^1.2.0",
    "@emotion/react": "^11.11.0",
    "@emotion/styled": "^11.11.0",
    "@mui/icons-material": "^5.18.0",
    "@mui/material": "^5.16.0",
    "react": "^18.0.0",
    "react-use": "^17.2.4",
    "recharts": "^2.15.4",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@backstage/catalog-client": "^1.16.1",
    "@backstage/cli": "^0.36.2",
    "@backstage/frontend-defaults": "^0.5.3",
    "@backstage/frontend-test-utils": "^0.6.0",
    "@backstage/test-utils": "^1.7.0",
    "@microsoft/api-extractor": "^7.59.0",
    "@testing-library/dom": "^10.0.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.0.0",
    "@types/node": "^20.19.43",
    "@types/react": "^18.2.0",
    "esbuild": "^0.28.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.30.0",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@types/react": "^18.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-router-dom": "^6.20.0"
  },
  "overrides": {
    "@peculiar/asn1-schema": "2.9.2"
  }
}
