# Dependencies
node_modules
.pnp
.pnp.js
.pnp.cjs
.yarn/

# Root has no real dependency tree of its own (see package.json) — nothing
# to lock. Each package under packages/* commits its own package-lock.json
# so `npm ci` gets reproducible, non-floating installs in CI and publish.
yarn.lock

# Build outputs (built separately in monorepo and copied)
dist/

# API Extractor intermediate doc-model output (report.api.md is the
# committed artifact; this is scratch it regenerates each run)
temp/

# Testing
coverage

# Misc
.DS_Store
*.log
*.local

# IDE and editor configs
.vscode/
.idea/
*.swp
*.swo
*~

# Local cache and MCP artifacts
.claude/settings.local.json
.playwright-mcp/

# Environment and secrets
.env
.env.local

