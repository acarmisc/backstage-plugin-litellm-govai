{
  "name": "@govai/backstage-plugin-litellm-monorepo",
  "version": "0.0.1",
  "private": true,
  "description": "LiteLLM Governance plugin packages for Backstage. Designed for use within Backstage monorepo.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @acarmisc/backstage-plugin-litellm-common && npm run build -w @acarmisc/backstage-plugin-litellm-backend -w @acarmisc/backstage-plugin-litellm --if-present",
    "test": "npm run build -w @acarmisc/backstage-plugin-litellm-common && npm test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  },
  "overrides": {
    "@yarnpkg/core": "4.9.1",
    "@azure/identity": "4.14.1",
    "fast-xml-parser": "5.12.0",
    "@octokit/rest": "20.1.2",
    "@octokit/request": "8.4.1",
    "@octokit/request-error": "5.1.1",
    "@octokit/auth-app": "6.1.4",
    "@octokit/auth-oauth-app": "7.1.0",
    "uuid": "8.3.2",
    "prismjs": "1.30.0",
    "@backstage/integration": {
      "@octokit/rest": "20.1.2",
      "@octokit/auth-app": "6.1.4"
    },
    "@material-table/core": {
      "uuid": "8.3.2"
    },
    "refractor": {
      "prismjs": "1.30.0"
    }
  }
}
